{
  "server": {
    "host": "0.0.0.0",
    "port": 80,
    "debug": false
  },
  "security": {
    "tokens": [
      "ptqmt_secret_token_2025",
      "jq_strategy_token",
      "qmt_client_token"
    ],
    "allowed_ips": [
      "127.0.0.1",
      "192.168.1.0/24"
    ]
  },
  "storage": {
    "type": "memory",
    "redis_url": "redis://localhost:6379/0",
    "database_url": "sqlite:///proxy.db"
  },
  "logging": {
    "level": "INFO",
    "file": "ptqmt_proxy.log",
    "max_size": "10MB",
    "backup_count": 5
  },
  "limits": {
    "max_signals_per_request": 20,
    "signal_ttl": 3600,
    "result_ttl": 86400
  }
}